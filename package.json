{
  "name": "netlify-ts",
  "version": "3.0.0",
  "description": "Turn your Decap CMS (formerly Netlify CMS) collections into TypeScript typings!",
  "repository": "jsaari97/netlify-ts",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "author": "Jim Saari",
  "keywords": [
    "netlify",
    "decap",
    "cms",
    "typescript",
    "types",
    "generate"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": "./bin/run.js",
  "files": [
    "/bin",
    "/lib"
  ],
  "scripts": {
    "prebuild": "rm -rf lib",
    "build": "tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint --fix",
    "kitchen-sink": "node ./bin/run.js kitchen-sink.yml",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.0.0",
    "ora": "^9.3.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/yargs": "^17.0.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --cache --fix",
    "*.{ts,js,css,md}": "prettier --write"
  }
}
